---
import type { Post } from "../utils/content";
import {
  formatDate,
  getPostPath,
  getReadingTime,
  tagToSlug,
} from "../utils/content";
import Icon from "./Icon.astro";

interface Props {
  post: Post;
  featured?: boolean;
  compact?: boolean;
}

const { post, featured = false, compact = false } = Astro.props;
const { data } = post;
const cover = data.cover ?? "/images/cover-blog.svg";
const readingTime = getReadingTime(post.body);
---

<article class:list={["post-card", { "post-card-featured": featured, "post-card-compact": compact }]}>
  <a class="post-card-hit-area" href={getPostPath(post)} aria-label={`阅读《${data.title}》`}></a>
  <div class="post-card-link">
    {
      !compact && (
        <div class="post-card-cover">
          <img src={cover} alt="" loading="lazy" width="1200" height="760" />
          <span class="post-card-glow" aria-hidden="true"></span>
        </div>
      )
    }
    <div class="post-card-content">
      <div class="post-kicker">
        {data.featured && <span class="featured-badge"><Icon name="spark" size={14} /> 精选</span>}
        <span>{data.category}</span>
      </div>
      <h3 class="post-title">{data.title}</h3>
      <p class="post-description">{data.description}</p>
      <div class="post-meta">
        <span><Icon name="calendar" size={15} /> {formatDate(data.publishedAt)}</span>
        <span><Icon name="clock" size={15} /> {readingTime} 分钟</span>
      </div>
      <div class="post-tags">
        {
          data.tags.slice(0, featured ? 4 : 3).map((tag) => (
            <a class="tag-chip" href={`/tags/${tagToSlug(tag)}/`}>#{tag}</a>
          ))
        }
      </div>
    </div>
    <span class="post-card-arrow"><Icon name="arrowRight" size={20} /></span>
  </div>
</article>
